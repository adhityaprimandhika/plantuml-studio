# Port the Express server listens on
PORT=6000

# Internal PlantUML render server (see docker-compose.yml)
PLANTUML_SERVER_URL=http://localhost:8080

# Ollama server. If Ollama runs on the VPS host (not in Docker),
# use http://host.docker.internal:11434 when this app runs in Docker,
# or http://127.0.0.1:11434 if this app runs directly on the host.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any model you have pulled: `ollama pull llama3`, `ollama pull qwen2.5-coder`, etc.
OLLAMA_MODEL=gemma4:e2b
